# oly-ingestion/.env.example
# Copy this file to .env and fill in real values before running docker compose.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.

# ── Postgres credentials ───────────────────────────────────────────────────
# Used by docker-compose to initialise Postgres and by PgBouncer to connect.
# Change POSTGRES_PASSWORD before starting containers for the first time.
POSTGRES_USER=oly
POSTGRES_PASSWORD=change_me_before_first_run
POSTGRES_DB=oly_programming

# ── Application database URL ───────────────────────────────────────────────
# Points at PgBouncer (port 5432). Must match POSTGRES_* credentials above.
DATABASE_URL=postgresql://oly:change_me_before_first_run@localhost:5432/oly_programming

# ── Redis ──────────────────────────────────────────────────────────────────
# Use 127.0.0.1, not localhost: on Windows localhost resolves to IPv6 ::1 first,
# which Docker's 127.0.0.1:6379 mapping doesn't bind, and ARQ's 1s connect
# timeout expires before the IPv4 fallback (background jobs silently fail).
REDIS_URL=redis://127.0.0.1:6379

# ── API keys / provider ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                # embeddings with EMBEDDING_PROVIDER=openai (the default)
#
# Embeddings (oly-ingestion/loaders/embedders.py). One provider, one model; every provider
# fits vectors to the vector(1536) column and rows record their model, so switching is
# `reembed.py` + a golden/baseline rebuild (docs/RETRIEVAL_EVAL.md), never a schema change.
#   openai         OPENAI_API_KEY; EMBEDDING_MODEL default text-embedding-3-large (Matryoshka-truncated to embedding_dim 1536; -small until 2026-09-22)
#   openai_compat  any OpenAI-shaped /v1/embeddings server — Together, Ollama
#                  (http://localhost:11434/v1), text-embeddings-inference, vLLM
#   local          a sentence-transformers model on this machine; CPU is enough here
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_PROVIDER=openai_compat
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=bge-m3
#
# LLM provider. Every LLM call goes through the Anthropic SDK; LLM_PROVIDER picks
# the endpoint and key:
#   anthropic   api.anthropic.com with ANTHROPIC_API_KEY (Claude models only; Message
#               Batches available, so ingestion --batch runs at half price)
#   openrouter  OpenRouter's Anthropic-compatible endpoint with OPENROUTER_API_KEY —
#               Claude at first-party rates + 5.5 % on credits, plus open models by
#               vendor id (moonshotai/kimi-k3, deepseek/deepseek-v4.1-flash,
#               z-ai/glm-5.3-flash …); no Batches, --batch runs synchronously.
#               Claude ids are rewritten automatically ("claude-sonnet-5" ->
#               "anthropic/claude-sonnet-5").
# openrouter is the code default since 2026-09-22 (the dev setup since 2026-09-20; a
# Canadian account could not sign up for Fireworks, OpenRouter had no restriction).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...        # only needed with LLM_PROVIDER=anthropic
# TYPESAFE_API_KEY=ts-...             # optional: Jev (typesafe.ai) for label/score decisions —
#                                     # relabel_chunk_types.py --judge jev (see docs/SETUP.md)
#
# Model roles. Defaults in shared/config.py depend on the provider: under openrouter
# Kimi K3 / DeepSeek V4.1 Flash / GLM-5.3 Flash judge / Kimi K3 (the values below);
# under anthropic Claude Sonnet 5 / Haiku 4.5 / Sonnet 5.
#   LLM_MODEL          ingestion heavy lifting: principle extraction, vision OCR (and templates unless
#                      TEMPLATE_MODEL is set)
#   TEMPLATE_MODEL     program-template parsing; blank = LLM_MODEL. Exists so templates can be pinned to
#                      a different model: DeepSeek returned malformed JSON on long template outputs;
#                      Kimi K3 was 8/9 (the miss was a prose-led section, a data issue) and is used as is
#   LIGHT_MODEL        labels / summaries: classifier fallback, --contextualize, relabel
#   JUDGE_MODEL        golden-set grader for the retrieval eval (JUDGE-1); blank = LIGHT_MODEL. Changing it
#                      re-freezes the baseline — run eval/judge_agreement.py + judge_adjudicate.py first
#   GENERATION_MODEL   the agent's per-session generation call
#   EXPLANATION_MODEL  the agent's program rationale
# 2026-09-20 model baseline (eval/model_baseline_20260920T190526Z.json): every model below
# was 8/8 first-try with 0 parse / validation errors; Kimi K3 at 60 % of Sonnet 5's cost with
# the closest output, DeepSeek V4.1 Flash at 5 % matching Haiku on every light task.
LLM_MODEL=moonshotai/kimi-k3
# TEMPLATE_MODEL=claude-sonnet-5          # only if template parses start going missing
LIGHT_MODEL=deepseek/deepseek-v4.1-flash
JUDGE_MODEL=z-ai/glm-5.3-flash
GENERATION_MODEL=moonshotai/kimi-k3
EXPLANATION_MODEL=moonshotai/kimi-k3
# Thinking / effort for the agent roles. Default: thinking disabled (Sonnet 5 / Opus 5 run adaptive
# thinking when it is omitted, and it counts against max_tokens — raise the budgets if you enable it).
# GENERATION_THINKING=disabled   # adaptive, disabled
# GENERATION_EFFORT=             # "", low, medium, high, xhigh, max
# EXPLANATION_THINKING=disabled
# EXPLANATION_EFFORT=

# ── Web / session ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# ── Production overrides (uncomment when deploying) ───────────────────────
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# HTTPS_ONLY=true
